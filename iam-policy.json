{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Route53RecordOperations",
      "Effect": "Allow",
      "Action": [
        "route53:ChangeResourceRecordSets",
        "route53:ListResourceRecordSets",
        "route53:GetHostedZone"
      ],
      "Resource": [
        "arn:aws:route53:::hostedzone/ZPS49ZOFSRKVC",
        "arn:aws:route53:::hostedzone/Z06858143PXEUA7VN6S4G"
      ]
    },
    {
      "Sid": "Route53ChangePolling",
      "Effect": "Allow",
      "Action": "route53:GetChange",
      "Resource": "arn:aws:route53:::change/*"
    }
  ]
}
